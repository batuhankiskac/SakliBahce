-            screens_.show(ui::ScreenId::None);
-            startMatch();
-        }
-        return;
-    }
-    screenT_ += simDt;
-    screens_.setAutoAdvance(std::max(0.f, wait - screenT_) / std::max(0.05f, opt_.speed));
