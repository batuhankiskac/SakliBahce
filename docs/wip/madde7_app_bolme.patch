-    if (e.player != HUMAN || e.text.empty()) return e.text;
-    switch (e.type) {
-    case EvType::MatchStart:
-    case EvType::HandStart: return e.text; // (player = the starter: nothing said to anyone)
-    case EvType::TurnStart: return "Sıra yapay zekada";
