-    }
-    std::istringstream in(e.text);
-    std::string word, out;
-    bool first = true;
-    while (in >> word) {
-        if (first) { // a sentence-initial verb goes lower case; a tile's name keeps its capital ("Kırmızı 5'i işledin")
